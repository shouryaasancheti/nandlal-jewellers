# ==============================================================================
# NANDLAL JEWELLERS — ENVIRONMENT CONFIGURATION (.env.example)
# Copy to .env.local and supply real credentials before deploying to production.
# Never commit .env.local or real secrets to version control.
# ==============================================================================

# 1. Existing Laravel Backend (nandlaljewellers.com)
# Leave blank to run in explicit PLACEHOLDER_MOCK mode for local preview.
LARAVEL_API_BASE_URL=https://nandlaljewellers.com
LARAVEL_API_MODE=PLACEHOLDER_MOCK
# Optional server-to-server token if RPB CommoSoft exposes a headless API key:
LARAVEL_API_TOKEN=

# 2. Razorpay Payment Gateway (Confirmed provider on nandlaljewellers.com)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# 3. Google Maps Embed (Burrabazar, Kolkata Showroom)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 4. Store Concierge & WhatsApp (Verified live number: 9830026688)
NEXT_PUBLIC_WHATSAPP_NUMBER=919830026688
NEXT_PUBLIC_STORE_PHONE_PRIMARY=9830026688
NEXT_PUBLIC_STORE_PHONE_LANDLINE=033-46041858

# 5. Optional 3D Hero Model Slot
# Place a real GLB file at /public/models/hero.glb to automatically activate 3D drag-to-rotate mode.
NEXT_PUBLIC_HERO_GLB_PATH=/models/hero.glb

# 6. Site Metadata
NEXT_PUBLIC_SITE_URL=https://nandlaljewellers.com
